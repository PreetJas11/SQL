-- Find the sales greater than $100 and then select the average of those high value sales.

WITH sales AS (
    SELECT SaleId, SalesAmount as topsales from DailySales WHERE SalesAmount > 100
)
Select AVG(topsales) FROM sales;

-- Rank the Sales within each category from the highest to lowest amount. Order the result by Product Category and then the sales rank.

WITH salesrank AS (
    select saleId, SalesAmount, ProductCategory, DENSE_RANK() OVER(PARTITION By ProductCategory ORDER By SalesAmount DESC)as rnk from DailySales
)
SELECT saleId, SalesAmount, ProductCategory FROM salesrank ORDER BY ProductCategory;
