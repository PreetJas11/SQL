-- Get customer name, product name, and order amount
select * from Customer1 c inner join Order1 o on c.cust_id = o.order_id inner join Product p  on o.order_id = p.product_id;

-- Find products never ordered
select * from Order1 o INNER JOIN Product p on o.order_id = p.product_id where o.order_id=NULL;

--  Products more than 1 less than 5
select * from Order1 o INNER JOIN Product p on o.order_id = p.product_id INNER JOIN Order_Product op on p.product_id=op.product_id WHERE op.quantity>1 AND op.quantity<5;

-- Total Revenue per product category
select SUM(o.amount), p.name from Order1 o INNER JOIN Product p on o.order_id=p.product_id GROUP BY p.name;

-- SELF JOIN

CREATE TABLE Employees (
    employee_id INT PRIMARY KEY,
    name VARCHAR(50),
    manager_id INT NULL,
    FOREIGN KEY (manager_id) REFERENCES Employees(employee_id)
);

