-- Find Emp-Manager pairs

SELECT e.name, m.name from Employees e LEFT JOIN Employees m on e.manager_id = m.employee_id;

-- Emp who not manage anyone
SELECT e.name from Employees e LEFT JOIN Employees m on e.employee_id = m.manager_id WHERE m.employee_id=null;

-- Count how many employees report to each manager
SELECT m.name,COUNT(e.employee_id)from Employees e LEFT JOIN Employees m on e.manager_id = m.employee_id GROUP BY m.name;

-- Top level manager
select name from Employees WHERE manager_id is NULL;
