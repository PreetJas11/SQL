-- JOINS--

-- Tables: customers (customer_id, name), orders (order_id, customer_id, amount)

CREATE TABLE Customer1 (
    cust_id INT PRIMARY KEY,
    name VARCHAR(20)
)

create table Order1 (
    order_id INT PRIMARY KEY,
    cust_id INT FOREIGN KEY REFERENCES Customer1(cust_id),
    amount DECIMAL(10,2)
)

